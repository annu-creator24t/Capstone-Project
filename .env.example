# Simulation and Digital Twin Environment Configuration Example
# Copy this file to .env and adjust variables as needed

VEHICLE_ID=EV_001
SIMULATION_DT_SECONDS=1.0
SIMULATION_RANDOM_SEED=42

# Telemetry / Cloud Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=vehicles/EV_001/telemetry
MQTT_TOPIC_COMMANDS=vehicles/EV_001/commands

REST_API_HOST=127.0.0.1
REST_API_PORT=8000
